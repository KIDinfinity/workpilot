# 生产 Caddyfile（IP + HTTP，先不启用域名/TLS）
# http:// 前缀 = 关掉自动 HTTPS（不申请证书）；IP 地址 = 域名留给后续优化项
http://8.148.216.61 {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}
	handle /v1/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /ready {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
