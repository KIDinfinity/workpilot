:80 {
	handle /v1/* {
		reverse_proxy api:8000 {
			flush_interval -1    # SSE：每个 token 立即下发，不缓冲
		}
	}
	handle /health {
		reverse_proxy api:8000
	}
	handle /ready {
		reverse_proxy api:8000
	}
	handle {
		root * /srv
		encode gzip            # 只压缩静态资源，不作用于 SSE
		try_files {path} /index.html
		file_server
	}
}
