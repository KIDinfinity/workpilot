# ===== 应用 =====
# [必填] 运行环境：dev | test | prod
APP_ENV=dev
# [可选] 日志级别：DEBUG | INFO | WARNING | ERROR（默认 INFO）
LOG_LEVEL=INFO
# [可选] JSON 日志：1=结构化 JSON（默认），0=纯文本（本地调试用）
LOG_JSON=1

# ===== LLM（统一经 M1 LLM Gateway，OpenAI 兼容协议）=====
# ★ 切供应商只改这一行：deepseek | doubao | ollama
#   预设（base_url / model）见 apps/api/app/core/llm_providers.py
#   改完必须重启 make dev（get_settings 有 lru_cache）
LLM_PROVIDER=deepseek

# 各供应商密钥分开存，切换时不用重填、也不会互相覆盖
# [密钥] 只写在 .env，不要提交；Ollama 无需填（预设已给占位串）
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=

# [可选] 留空 = 用预设模型；火山方舟的推理接入点 ID（ep-xxxxxxxx）填这里
LLM_MODEL=

# [可选] 单次请求超时（秒，默认 30）
LLM_TIMEOUT_S=30
# [可选] 最大尝试次数（含首次），默认 3
LLM_MAX_ATTEMPTS=3

# ===== 成本计量（价格每百万 tokens，未配置则 cost=None，不猜）=====
# 价格：从 https://api-docs.deepseek.com/quick_start/pricing 抄写当前 deepseek-chat 价格（每百万 tokens）
PRICE_CURRENCY=CNY
PRICE_INPUT_HIT_PER_M=
PRICE_INPUT_MISS_PER_M=
PRICE_OUTPUT_PER_M=

# ===== Embedding（bge-m3，1024 维；dev=Ollama，prod=SiliconFlow 同模型）=====
# [必填] 容器内访问宿主机 Ollama 时改为 http://host.docker.internal:11434/v1
EMBEDDING_BASE_URL=http://localhost:11434/v1
# [必填·密钥] Ollama 填 ollama；SiliconFlow 填真实 key
EMBEDDING_API_KEY=ollama
# [必填] Ollama 为 bge-m3；SiliconFlow 以其模型列表名称为准
EMBEDDING_MODEL=bge-m3

# ===== 向量库 Qdrant =====
# [必填] HTTP 端口 6333
QDRANT_URL=http://localhost:6333

# ===== RAG 检索（ADR 0003；SCORE_THRESHOLD 由 W5 评测校准）=====
# [可选] 分块大小，默认 600
CHUNK_SIZE=600
# [可选] 分块重叠，默认 100
CHUNK_OVERLAP=100
# [可选] 检索返回数量，默认 5
TOP_K=5
# [可选] 检索模式：dense | hybrid，默认 dense
RETRIEVAL_MODE=dense
# [可选] dense 检索拒答阈值；低于该分数时不返回结果
SCORE_THRESHOLD=0.52
# [可选] 版本化回答 prompt
ANSWER_PROMPT=qa_answer.v2

# ===== 对象存储 MinIO（S3 兼容）=====
# [必填] API 端口 9000（控制台 9001 不在这里配）
MINIO_ENDPOINT=http://localhost:9000
# [必填·密钥]
MINIO_ACCESS_KEY=
# [必填·密钥]
MINIO_SECRET_KEY=

# ===== 业务库 =====
# [必填] W6 起 SQLite；W19 改为 postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/app.db